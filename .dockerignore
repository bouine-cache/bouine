# Build context exclusions — keeps the context lean and prevents
# unrelated file changes from busting the go mod download layer cache.

# Build artifacts
bin/
*.test
*.out
coverage.*
cover.html

# Development tools & IDE
.crush/
.idea/
.vscode/
*.local.yaml
*.local.yml
.env
.env.local
.envrc

# Local secrets / cluster credentials (never in image)
kubeconfig.yaml

# Git
.git/
.github/

# Documentation (not needed in image)
docs/
PLAN*.md
AGENTS.md
HANDOFF.md
*.md
!go.mod
!go.sum

# Test infrastructure (large, never needed in the binary)
bench/
test/
testdata/

# Deploy / infra / dev tooling (not compiled into the binary)
deploy/
scripts/
lint/
examples/
api/

# Repo metadata & dev configs (not needed at runtime)
Dockerfile
.dockerignore
.gitignore
.golangci.yaml
.gitleaks.toml
.pre-commit-config.yaml
codecov.yml
CODEOWNERS
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
LICENSE
Makefile
package-lock.json

# Stray directories that can appear from kubectl port-forward cleanup
origin

# macOS metadata
.DS_Store
**/.DS_Store
