{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bouine Helm chart values",
  "description": "Default values for the bouine cloud-native HTTP cache Helm chart.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "description": "Number of bouine replicas in the StatefulSet.",
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "image": {
      "description": "Container image configuration.",
      "type": "object",
      "properties": {
        "repository": {
          "description": "Container image repository.",
          "type": "string",
          "default": "bouinecache/bouine"
        },
        "tag": {
          "description": "Container image tag. Defaults to the chart appVersion when empty.",
          "type": "string",
          "default": ""
        },
        "pullPolicy": {
          "description": "Kubernetes image pull policy.",
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "IfNotPresent"
        },
        "pullSecrets": {
          "description": "List of Kubernetes Secret names for pulling from private registries.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "default": []
        }
      },
      "required": ["repository", "pullPolicy"]
    },
    "serviceAccount": {
      "description": "Service account for the bouine pods.",
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "automount": {
          "type": "boolean",
          "default": false
        },
        "annotations": {
          "type": "object",
          "default": {}
        },
        "name": {
          "type": "string",
          "default": ""
        }
      }
    },
    "nameOverride": {
      "description": "Override the chart name used in resource names.",
      "type": "string",
      "default": ""
    },
    "fullnameOverride": {
      "description": "Override the fully qualified resource name.",
      "type": "string",
      "default": ""
    },
    "config": {
      "description": "bouine configuration rendered into a ConfigMap mounted at /etc/bouine/.",
      "type": "object",
      "properties": {
        "listen": {
          "description": "Listen addresses and connection limits for the data, admin, and cluster ports.",
          "type": "object",
          "properties": {
            "http": {
              "type": "string",
              "default": ":80"
            },
            "https": {
              "type": "string",
              "default": ":443"
            },
            "admin": {
              "type": "string",
              "default": ":9000"
            },
            "cluster": {
              "type": "string",
              "default": ":8443"
            },
            "max_connections": {
              "description": "Cap on simultaneously open data-plane connections. Under HTTP/1.1 this bounds in-flight requests; over-limit connections receive 503 + close. Idle keep-alive connections hold a slot. 0 disables the limit.",
              "type": "integer",
              "minimum": 0,
              "default": 4096
            },
            "idle_timeout": {
              "description": "Keep-alive idle timeout for data-plane connections (default 120s). Keep an nginx front-end's keepalive_timeout BELOW this so nginx closes idle connections first; otherwise bouine may close a connection mid-reuse and nginx logs 'upstream prematurely closed connection'.",
              "type": "string",
              "pattern": "^[0-9]+(ns|us|ms|s|m|h)$",
              "default": "120s"
            }
          }
        },
        "tls": {
          "description": "TLS certificate configuration. Provide via a Secret mounted at /etc/bouine/tls/.",
          "type": "object",
          "properties": {
            "certs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cert_file": {
                    "type": "string"
                  },
                  "key_file": {
                    "type": "string"
                  }
                }
              },
              "default": []
            }
          }
        },
        "storage": {
          "description": "Hot (RAM) and warm (disk) tier storage configuration.",
          "type": "object",
          "properties": {
            "hot_max_bytes": {
              "description": "Maximum size of the hot (RAM) tier. Accepts binary suffixes (GiB, MiB, KiB) or a plain byte count.",
              "type": "string",
              "default": "2GiB"
            },
            "warm_dir": {
              "description": "Directory path for warm-tier mmap-backed storage.",
              "type": "string",
              "default": "/var/lib/bouine"
            },
            "warm_max_bytes": {
              "description": "Maximum size of the warm (disk) tier.",
              "type": "string",
              "default": "20GiB"
            },
            "warm_sync_interval": {
              "description": "Hot-to-warm background sync interval. Set to -1 to disable.",
              "type": "string",
              "default": "60s"
            },
            "warm_sync_batch_size": {
              "type": "integer"
            },
            "body_threshold": {
              "type": "string"
            }
          }
        },
        "cluster": {
          "description": "Cluster gossip configuration. The join list is auto-populated from the headless service DNS.",
          "type": "object",
          "properties": {
            "join": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        },
        "admin": {
          "description": "Admin server configuration.",
          "type": "object",
          "properties": {
            "drain_duration": {
              "description": "Block duration for the /drain endpoint used by the preStop hook.",
              "type": "string"
            }
          }
        },
        "upstream_pools": {
          "description": "Upstream origin pools. See the bouine configuration documentation for the full schema.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Pool name, referenced by routes[].pool.",
                "type": "string"
              },
              "targets": {
                "description": "Origin target addresses.",
                "type": "array",
                "items": {"type": "string"}
              },
              "connect": {
                "description": "Connection policy for origin targets. Zero/empty values apply built-in defaults.",
                "type": "object",
                "properties": {
                  "timeout": {
                    "description": "TCP dial timeout. Default 10s.",
                    "type": "string",
                    "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
                  },
                  "keep_alive": {
                    "description": "TCP keep-alive probe interval. Default 30s.",
                    "type": "string",
                    "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
                  },
                  "max_connections": {
                    "description": "Max concurrent connections per origin host. Default 64.",
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_idle_conn_duration": {
                    "description": "Idle pooled-connection lifetime. Default 90s. Keep below any LB idle timeout in the path (AWS NLB: 350s).",
                    "type": "string",
                    "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
                  },
                  "response_header_timeout": {
                    "description": "Max wait for origin response headers. Default 30s.",
                    "type": "string",
                    "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
                  },
                  "hedge_timeout": {
                    "description": "Fire a duplicate request after this duration; first response wins. Empty disables.",
                    "type": "string",
                    "pattern": "^$|^[0-9]+(ns|us|ms|s|m|h)$"
                  }
                }
              }
            }
          },
          "default": []
        },
        "routes": {
          "description": "Routing rules. See the bouine configuration documentation for the full schema.",
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "cloudflare": {
          "description": "Cloudflare Cache API invalidation propagation. The API token is injected via cloudflare.apiTokenSecretName, not placed here.",
          "type": "object",
          "properties": {
            "zone_id": {
              "type": "string"
            },
            "api_tokens": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Additional API tokens for rate limit spreading. The primary token is injected via CF_API_TOKEN env var. Additional tokens can be injected via CF_API_TOKENS (comma-separated)."
            },
            "propagate": {
              "type": "object",
              "properties": {
                "purge": {
                  "type": "boolean"
                },
                "ban": {
                  "type": "boolean"
                },
                "refresh": {
                  "type": "boolean"
                }
              }
            },
            "async": {
              "type": "boolean"
            },
            "timeout": {
              "type": "string"
            },
            "batch": {
              "type": "object",
              "description": "Purge batching and deduplication. When max_batch_size > 0, individual purges are coalesced into batched, deduplicated API calls to reduce CF rate limit pressure.",
              "properties": {
                "max_batch_size": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Maximum items per CF API call. 0 disables batching (passthrough mode)."
                },
                "max_wait": {
                  "type": "string",
                  "description": "Maximum time an item waits before flush. Default 500ms."
                }
              }
            },
            "circuit": {
              "type": "object",
              "description": "Circuit breaker for CF API outage protection.",
              "properties": {
                "enabled": {"type": "boolean"},
                "failure_threshold": {"type": "integer", "minimum": 0},
                "open_timeout": {"type": "string"},
                "half_open_max_calls": {"type": "integer", "minimum": 0}
              }
            },
            "retry": {
              "type": "object",
              "description": "Dead-letter queue for failed CF purges. Failed items are retried with exponential backoff.",
              "properties": {
                "enabled": {"type": "boolean"},
                "max_queue_size": {"type": "integer", "minimum": 0},
                "max_retries": {"type": "integer", "minimum": 0},
                "base_delay": {"type": "string"},
                "max_delay": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "service": {
      "description": "ClusterIP Service exposing the data and admin ports.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "default": "ClusterIP"
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 80
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 443
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9000
        }
      }
    },
    "headlessService": {
      "description": "Headless Service for gossip peer discovery.",
      "type": "object",
      "properties": {
        "clusterPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8443
        }
      }
    },
    "resources": {
      "description": "Container resource requests and limits.",
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": ["string", "number"]
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": ["string", "number"]
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "podAnnotations": {
      "description": "Annotations applied to bouine pods.",
      "type": "object",
      "default": {}
    },
    "podLabels": {
      "description": "Additional labels applied to bouine pods.",
      "type": "object",
      "default": {}
    },
    "affinity": {
      "description": "Kubernetes affinity rules for bouine pods.",
      "type": "object",
      "default": {}
    },
    "podAntiAffinity": {
      "description": "Raw Kubernetes pod anti-affinity rules. Explicit affinity takes precedence.",
      "type": "object",
      "default": {}
    },
    "nodeSelector": {
      "description": "Node labels required for bouine pods.",
      "type": "object",
      "default": {}
    },
    "tolerations": {
      "description": "Taints tolerated by bouine pods.",
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "priorityClassName": {
      "description": "PriorityClass assigned to bouine pods.",
      "type": "string",
      "default": ""
    },
    "dnsPolicy": {
      "description": "DNS policy for bouine pods.",
      "type": "string",
      "default": ""
    },
    "dnsConfig": {
      "description": "Custom DNS configuration for bouine pods.",
      "type": "object",
      "default": {}
    },
    "podSecurityContext": {
      "description": "Pod-level security context.",
      "type": "object"
    },
    "containerSecurityContext": {
      "description": "Container-level security context.",
      "type": "object"
    },
    "podDisruptionBudget": {
      "description": "PodDisruptionBudget to ensure quorum during disruptions.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "minAvailable": {
          "type": "integer"
        }
      }
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints to distribute pods across zones.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string",
            "minLength": 1
          },
          "whenUnsatisfiable": {
            "type": "string",
            "enum": ["DoNotSchedule", "ScheduleAnyway"]
          },
          "labelSelector": {
            "type": "object"
          },
          "matchLabelKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodeAffinityPolicy": {
            "type": "string",
            "enum": ["Honor", "Ignore"]
          },
          "nodeTaintsPolicy": {
            "type": "string",
            "enum": ["Honor", "Ignore"]
          }
        }
      }
    },
    "podManagementPolicy": {
      "description": "StatefulSet pod management policy.",
      "type": "string",
      "enum": ["OrderedReady", "Parallel"],
      "default": "Parallel"
    },
    "terminationGracePeriodSeconds": {
      "description": "Grace period before the pod is force-killed.",
      "type": "integer",
      "default": 40
    },
    "updateStrategy": {
      "description": "StatefulSet rolling update strategy.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["RollingUpdate", "OnDelete"],
          "default": "RollingUpdate"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "minReadySeconds": {
      "description": "Seconds after a pod becomes Ready before it enters Service endpoints.",
      "type": "integer",
      "default": 30
    },
    "goMemLimit": {
      "description": "Go runtime GOMEMLIMIT. Leave empty to auto-compute as 75% of resources.limits.memory.",
      "type": "string",
      "default": ""
    },
    "goGC": {
      "description": "Go runtime GOGC value.",
      "type": "string",
      "default": "100"
    },
    "cloudflare": {
      "description": "Cloudflare API token secret injection for CDN invalidation propagation.",
      "type": ["object", "null"],
      "properties": {
        "apiTokenSecretName": {
          "type": "string"
        },
        "apiTokenSecretKey": {
          "type": "string",
          "default": "CF_API_TOKEN"
        }
      }
    },
    "extraEnv": {
      "description": "Extra environment variables injected into the bouine container.",
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "extraVolumes": {
      "description": "Extra volumes to add to the bouine pod (e.g. for TLS secrets, custom CA bundles, or static files).",
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "extraVolumeMounts": {
      "description": "Extra volume mounts to add to the bouine container.",
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "startupProbe": {
      "description": "Startup probe configuration.",
      "type": "object"
    },
    "readinessProbe": {
      "description": "Readiness probe configuration.",
      "type": "object"
    },
    "livenessProbe": {
      "description": "Liveness probe configuration.",
      "type": "object"
    },
    "autoscaling": {
      "description": "Horizontal Pod Autoscaler (CPU-only). Disabled by default.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "default": 6
        },
        "cpuTrigger": {
          "type": "object",
          "properties": {
            "targetType": {
              "type": "string",
              "enum": ["Utilization", "AverageValue"],
              "default": "Utilization"
            },
            "averageUtilization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 70
            }
          }
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 120
        }
      }
    },
    "warmVolume": {
      "description": "PVC for the warm-tier disk storage.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "size": {
          "type": "string",
          "default": "50Gi"
        },
        "storageClass": {
          "type": "string",
          "default": ""
        },
        "annotations": {
          "type": "object",
          "default": {}
        },
        "labels": {
          "type": "object",
          "default": {}
        }
      }
    },
    "persistentVolumeClaimRetentionPolicy": {
      "description": "Optional StatefulSet PVC retention policy. Requires Kubernetes 1.27 or newer.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "whenScaled": {
          "type": "string",
          "enum": ["Retain", "Delete"],
          "default": "Retain"
        },
        "whenDeleted": {
          "type": "string",
          "enum": ["Retain", "Delete"],
          "default": "Retain"
        }
      }
    },
    "networkPolicy": {
      "description": "NetworkPolicy to restrict traffic. Disabled by default.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "serviceMonitor": {
      "description": "Prometheus ServiceMonitor for scraping metrics. Disabled by default.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "labels": {
          "type": "object",
          "default": {}
        },
        "interval": {
          "type": "string",
          "default": "60s"
        },
        "scrapeTimeout": {
          "type": "string",
          "default": ""
        },
        "relabelings": {
          "description": "Prometheus relabeling rules applied before scraping.",
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "metricRelabelings": {
          "description": "Prometheus metric relabeling rules applied after scraping.",
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        }
      }
    },
    "ingress": {
      "description": "Ingress for the data-plane HTTP/HTTPS ports. Disabled by default.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string",
          "default": ""
        },
        "annotations": {
          "type": "object",
          "default": {}
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": []
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        }
      }
    },
    "prometheusRule": {
      "description": "PrometheusRule CRD with alerting rules for bouine SLOs. Requires the Prometheus Operator. Disabled by default.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "labels": {
          "type": "object",
          "default": {}
        },
        "rules": {
          "description": "Alert threshold overrides. Adjust to match your traffic patterns and origin characteristics.",
          "type": "object",
          "properties": {
            "hitLatencyThreshold": {
              "description": "Hit-path p99 latency threshold in seconds (SLO DP-1).",
              "type": ["number", "string"],
              "default": 0.002
            },
            "errorRateThreshold": {
              "description": "5xx error rate threshold as a fraction (SLO DP-4).",
              "type": ["number", "string"],
              "default": 0.01
            },
            "hitRateThreshold": {
              "description": "Cache hit rate threshold as a fraction (SLO DP-3).",
              "type": ["number", "string"],
              "default": 0.60
            },
            "peerFetchHitRateThreshold": {
              "description": "Peer-fetch hit rate threshold as a fraction (SLO CL-2).",
              "type": ["number", "string"],
              "default": 0.50
            },
            "warmTierUsageThreshold": {
              "description": "Warm tier disk usage threshold as a fraction.",
              "type": ["number", "string"],
              "default": 0.90
            }
          }
        }
      }
    }
  }
}
