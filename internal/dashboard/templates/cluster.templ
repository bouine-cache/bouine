package templates

import (
	"fmt"
	"math"
	"strconv"

	"github.com/thylong/bouine/pkg/api"
)

// ringColors cycles through purple-spectrum colours per ring node.
var ringColors = []string{
	"#c4b5fd", "#8b5cf6", "#6d28d9", "#34d399", "#fb7185", "#fbbf24", "#60a5fa",
}

// Cluster renders the peer health table, uptime indicators, and the
// consistent-hash ring ownership SVG.
templ Cluster(d ClusterData) {
	@Layout(d.LayoutProps) {
		<div class="pg-hd">
			<div>
				<h2>Cluster peers</h2>
				<div class="sub">fan-out aggregated · 200ms timeout · stale = last-known data</div>
			</div>
		</div>
		if len(d.RingSegs) > 0 {
			<div class="bc" style="margin-bottom:.6rem">
				<div class="bc-t">Key-space distribution</div>
				@ringBand(d.RingSegs)
				<div style="display:flex;flex-wrap:wrap;gap:.35rem .75rem;margin-top:.5rem">
					for i, seg := range d.RingSegs {
						<span style={ fmt.Sprintf("font-size:.65rem;font-family:'JetBrains Mono',monospace;color:%s", ringColors[i % len(ringColors)]) }>
							■ { seg.NodeName } { fmt.Sprintf("%.1f%%", seg.Frac*100) }
						</span>
					}
				</div>
			</div>
		}
		<div
			class="tc"
			style="margin-bottom:.7rem"
			hx-get="/dashboard/cluster"
			hx-trigger="every 10s"
			hx-swap="outerHTML"
			hx-select=".tc"
		>
			<div class="th">
				<span class="tl">Live peers</span>
				<span style="font-size:.62rem;color:var(--m);font-family:'JetBrains Mono',monospace">
					{ strconv.Itoa(len(d.PeerResults)) } nodes
				</span>
			</div>
			<table>
				<thead>
					<tr>
						<th scope="col">Node</th>
						<th scope="col">Status</th>
						<th scope="col">Uptime 30m</th>
						<th scope="col">Routes</th>
						<th scope="col">Total req</th>
						<th scope="col">Hit %</th>
					</tr>
				</thead>
				<tbody>
					if len(d.PeerResults) == 0 {
						<tr>
							<td colspan="6" style="color:var(--m);padding:1rem;text-align:center">
								Single-node mode
							</td>
						</tr>
					}
					for _, peer := range d.PeerResults {
						<tr>
							<td>{ peer.NodeName }</td>
							<td>
								if peer.Stale {
									<span class="lz y">stale</span>
								} else {
									<span class="lz g">live</span>
								}
							</td>
							<td>{ formatUptime(d.PeerHealth[peer.NodeName]) }</td>
							<td>{ strconv.Itoa(len(peer.Summary.RouteStats)) }</td>
							<td>{ strconv.FormatInt(peerTotalReqs(peer), 10) }</td>
							<td>{ FmtHitPct(peerHitPct(peer)) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ringBand renders the consistent-hash ring as a proportional horizontal SVG
// band. Each node's colour-coded segment is proportional to its Frac.
templ ringBand(segs []api.RingSegment) {
	<svg
		viewBox="0 0 600 28"
		xmlns="http://www.w3.org/2000/svg"
		style="width:100%;height:28px;border-radius:5px;overflow:hidden;display:block"
		role="img"
		aria-label="Consistent-hash ring ownership"
	>
		for i, seg := range segs {
			<rect
				x={ fmt.Sprintf("%.3f", ringSegX(segs, i)) }
				y="0"
				width={ fmt.Sprintf("%.3f", seg.Frac*600) }
				height="28"
				fill={ ringColors[i % len(ringColors)] }
				opacity="0.85"
			>
				<title>{ seg.NodeName } ({ fmt.Sprintf("%.1f%%", seg.Frac*100) })</title>
			</rect>
		}
	</svg>
}

// ringSegX computes the cumulative x offset of segment i.
func ringSegX(segs []api.RingSegment, idx int) float64 {
	var x float64
	for i := range idx {
		x += segs[i].Frac * 600
	}
	return math.Round(x*1000) / 1000
}

func formatUptime(pct float64) string {
	if pct == 0 {
		return "—"
	}
	return fmt.Sprintf("%.0f%%", pct)
}

func peerTotalReqs(p PeerResult) int64 {
	var total int64
	for _, b := range p.Summary.RequestSnap {
		total += b.Requests
	}
	return total
}

func peerHitPct(p PeerResult) float64 {
	var reqs, hits int64
	for _, b := range p.Summary.RequestSnap {
		reqs += b.Requests
		hits += b.Hits
	}
	if reqs == 0 {
		return 0
	}
	return float64(hits) / float64(reqs) * 100
}
