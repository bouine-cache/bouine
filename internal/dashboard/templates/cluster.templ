package templates

import (
	"fmt"
	"math"
	"strconv"

	"github.com/bouine-cache/bouine/pkg/api"
)

// Cluster renders the peer health table, ring stats, circular ring SVG, and peer fetch stats.
templ Cluster(d ClusterData) {
	@Layout(d.LayoutProps) {
		<div class="pg-hd">
			<div>
				<h2>Cluster</h2>
				if d.Meta.Mode == "strong" {
					<div class="sub">gossip membership · consistent hash ring · peer fetch</div>
				} else if d.Meta.Mode == "eventual" {
					<div class="sub">gossip membership · local cache · gossip invalidation</div>
				} else {
					<div class="sub">gossip membership</div>
				}
			</div>
		</div>
		<div id="cluster-r21" class="r21" style="margin-bottom:.6rem"
			hx-get="/dashboard/cluster"
			hx-trigger="every 10s"
			hx-swap="outerHTML"
			hx-select="#cluster-r21"
		>
			<div class="bc">
				<div class="bc-t">Peer nodes</div>
				<table>
					<thead>
						<tr>
							<th scope="col">Node</th>
							<th scope="col">Data addr</th>
							<th scope="col">Admin addr</th>
							<th scope="col">Weight</th>
							<th scope="col">Joined</th>
							<th scope="col">Status</th>
						</tr>
					</thead>
					<tbody>
						if len(d.PeerResults) == 0 {
							<tr><td colspan="6" style="color:var(--m);padding:1rem;text-align:center">Single-node mode</td></tr>
						}
						for _, peer := range d.PeerResults {
							<tr>
								<td>{ peer.NodeName }</td>
								<td style="color:var(--m)">{ FmtAddrPort(peer.DataAddr) }</td>
								<td style="color:var(--m)">{ FmtAddrPort(peer.AdminAddr) }</td>
								<td>{ fmt.Sprintf("%.1f", peer.Weight) }</td>
								<td style="color:var(--m)">{ TimeAgo(peer.JoinedAt) }</td>
								<td>
									if peer.Stale {
										<span class="lz y">stale</span>
									} else {
										<span class="lz g">online</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="bc">
				<div class="bc-t">Cluster stats</div>
				<div class="stat-row"><span class="stat-k" title="Cluster consistency model. strong: ring-sharded keys with peer fetch. eventual: local cache, gossip invalidation.">mode</span><span class="stat-v">{ modeLabel(d.Meta.Mode) }</span></div>
				if d.Meta.Mode == "strong" {
					<div class="stat-row"><span class="stat-k" title="Number of virtual nodes placed on the ring per real node. More virtual nodes → more uniform key-space distribution.">virtual nodes / real</span><span class="stat-v">{ strconv.Itoa(d.Meta.VirtualNodes) }</span></div>
					<div class="stat-row"><span class="stat-k" title="Maximum allowed load imbalance between nodes relative to the average. 1.25 means a node can hold up to 25% more keys than perfect balance before the ring rebalances.">load factor</span><span class="stat-v">{ fmt.Sprintf("%.2f", d.Meta.LoadFactor) }</span></div>
					<div class="stat-row"><span class="stat-k" title="Maximum number of peer-fetch hops a single request can make before bouine falls through to the origin. Prevents infinite loops in multi-node clusters.">hop limit</span><span class="stat-v">{ strconv.Itoa(d.Meta.HopLimit) }</span></div>
					<div class="stat-row"><span class="stat-k" title="Maximum time to wait for a cache lookup response from a peer node before giving up and going to origin.">peer fetch timeout</span><span class="stat-v">{ d.Meta.PeerFetchTimeout }</span></div>
				} else if d.Meta.Mode == "eventual" {
					<div class="stat-row"><span class="stat-k" title="Replication strategy. None: each node only caches what it fetches from origin.">replication</span><span class="stat-v">none</span></div>
				}
				<div class="stat-row"><span class="stat-k" title="Internal cluster wire protocol version. Both endpoints must be within a N/N-1 compatibility window for peer fetch and broadcast to work.">protocol version</span><span class="stat-v">{ d.Meta.ProtocolVersion }</span></div>
				<div class="stat-row"><span class="stat-k" title="How often memberlist gossip rounds occur. Controls how quickly membership changes (joins, leaves, failures) propagate to all nodes.">gossip interval</span><span class="stat-v">{ d.Meta.GossipInterval }</span></div>
				<div class="stat-row"><span class="stat-k" title="Total time bouine keeps retrying cluster joins on startup before accepting single-node mode. Retries every 2s within this window.">join retry budget</span><span class="stat-v">{ d.Meta.JoinRetryBudget }</span></div>
			</div>
		</div>
		<div class="r2">
			if d.Meta.Mode == "strong" {
				<div class="bc">
					<div class="bc-t">Consistent hash ring — key ownership</div>
					if len(d.RingSegs) == 0 {
						<div style="font-size:.72rem;color:var(--m);padding:.5rem 0">Single-node · ring not populated</div>
					} else {
						@largeRingSVG(d.RingSegs)
					}
				</div>
				<div class="bc">
					<div class="bc-t">Peer fetch stats</div>
					<div class="stat-row"><span class="stat-k" title="Cache hits served from a peer node over the last 6 hours. The requesting pod found the key in another pod's hot tier instead of fetching from origin.">peer hits (6h)</span><span class="stat-v">{ strconv.FormatInt(d.FetchStats.Hits6h, 10) }</span></div>
					<div class="stat-row"><span class="stat-k" title="Peer fetch attempts that did not find the key in the target pod's cache (the target pod also had a miss). The request then fell through to origin.">peer misses (6h)</span><span class="stat-v">{ strconv.FormatInt(d.FetchStats.Misses6h, 10) }</span></div>
					<div class="stat-row">
						<span class="stat-k" title="Average round-trip time for peer-to-peer cache lookup RPCs. High values indicate network congestion or overloaded peers.">avg peer latency</span>
						<span class="stat-v">
							if d.FetchStats.AvgLatMs > 0 {
								{ fmt.Sprintf("%.2fms", d.FetchStats.AvgLatMs) }
							} else {
								—
							}
						</span>
					</div>
					<div class="stat-row"><span class="stat-k" title="Number of requests that reached the hop limit and went straight to origin. A non-zero value may indicate a routing misconfiguration or ring imbalance.">hop limit hits</span><span class="stat-v">{ strconv.FormatInt(d.FetchStats.HopLimitHits, 10) }</span></div>
					<div class="stat-row" style="margin-top:.5rem">
						<span class="stat-k" title="Average percentage of the last 30 minutes during which each peer was reachable. Computed from 30-second health samples.">uptime avg 30m</span>
						<span class="stat-v">{ peerHealthSummary(d.PeerHealth) }</span>
					</div>
				</div>
			} else if d.Meta.Mode == "eventual" {
				<div class="bc">
					<div class="bc-t">Eventual consistency mode</div>
					<div style="font-size:.72rem;color:var(--m);padding:.5rem 0;line-height:1.6">
						Each node caches independently. No key sharding. Invalidation
						propagates via gossip (eventual consistency, ~1–5 s convergence).
						No replication — nodes only cache what they fetch from origin.
					</div>
				</div>
				<div class="bc">
					<div class="bc-t">Gossip stats</div>
					<div class="stat-row"><span class="stat-k" title="Total gossip invalidation events (purges + bans) received from peers.">invalidations received</span><span class="stat-v">—</span></div>
					<div class="stat-row" style="margin-top:.5rem">
						<span class="stat-k" title="Average percentage of the last 30 minutes during which each peer was reachable.">uptime avg 30m</span>
						<span class="stat-v">{ peerHealthSummary(d.PeerHealth) }</span>
					</div>
				</div>
			}
		</div>
		if d.HasStoreData() {
			<div id="cluster-cache" style="margin-top:.7rem"
				hx-get="/dashboard/cluster"
				hx-trigger="every 10s"
				hx-swap="outerHTML"
				hx-select="#cluster-cache"
			>
				<div class="r2" style="margin-bottom:.5rem">
					<div class="bc">
						<div class="bc-t">Content size (bytes)</div>
						<div style="height:160px;position:relative">
							<canvas id="c-cache-bytes" aria-label="Cache content size distribution"></canvas>
							<div class="center-stat">
								<div class="val">{ FmtBytes(d.TotalBytes()) }</div>
								<div class="lbl">total cached</div>
							</div>
						</div>
						<div class="cache-legend">
							<span><span class="cache-legend-dot" style="background:#8b5cf6"></span>Hot { FmtBytes(d.HotBytes) } ({ fmt.Sprintf("%.0f%%", sharePct(d.HotBytes, d.TotalBytes())) })</span>
							<span><span class="cache-legend-dot" style="background:#60a5fa"></span>Warm { FmtBytes(d.WarmBytes) } ({ fmt.Sprintf("%.0f%%", sharePct(d.WarmBytes, d.TotalBytes())) })</span>
						</div>
					</div>
					<div class="bc">
						<div class="bc-t">Object count (entries)</div>
						<div style="height:160px;position:relative">
							<canvas id="c-cache-entries" aria-label="Cache object count distribution"></canvas>
							<div class="center-stat">
								<div class="val">{ FmtInt(int(d.TotalEntries())) }</div>
								<div class="lbl">total objects</div>
							</div>
						</div>
						<div class="cache-legend">
							<span><span class="cache-legend-dot" style="background:#8b5cf6"></span>Hot { FmtInt(int(d.HotEntries)) } ({ fmt.Sprintf("%.0f%%", sharePct(d.HotEntries, d.TotalEntries())) })</span>
							<span><span class="cache-legend-dot" style="background:#60a5fa"></span>Warm { FmtInt(int(d.WarmEntries)) } ({ fmt.Sprintf("%.0f%%", sharePct(d.WarmEntries, d.TotalEntries())) })</span>
						</div>
					</div>
				</div>
				<div class="r2">
					<div class="bc">
						<div class="bc-t">Hot tier (RAM)</div>
						<div class="stat-row"><span class="stat-k">entries</span><span class="stat-v">{ FmtInt(int(d.HotEntries)) }</span></div>
						<div class="tier-bar-wrap">
							<div class="tier-bar-label">
								<span>used</span>
								<span>{ FmtBytes(d.HotBytes) } / { FmtBytes(d.HotMaxBytes) }</span>
							</div>
							<div class="tier-bar" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", d.HotFillPct()) } aria-valuemin="0" aria-valuemax="100">
								<div class="tier-bar-fill" style={ fmt.Sprintf("width:%.1f%%", d.HotFillPct()) }></div>
							</div>
						</div>
						<div class="stat-row"><span class="stat-k">fill ratio</span><span class="stat-v">{ fmt.Sprintf("%.1f%%", d.HotFillPct()) }</span></div>
						<div class="stat-row"><span class="stat-k">evictions / min</span><span class="stat-v">{ FmtInt(int(d.Evictions)) }</span></div>
					</div>
					<div class="bc">
						<div class="bc-t">Warm tier (disk)</div>
						<div class="stat-row"><span class="stat-k">entries</span><span class="stat-v">{ FmtInt(int(d.WarmEntries)) }</span></div>
						<div class="tier-bar-wrap">
							<div class="tier-bar-label">
								<span>used</span>
								<span>{ FmtBytes(d.WarmBytes) } / { FmtBytes(d.WarmMaxBytes) }</span>
							</div>
							<div class="tier-bar">
								<div class="tier-bar-fill warm" style={ fmt.Sprintf("width:%.1f%%", d.WarmFillPct()) }></div>
							</div>
						</div>
						<div class="stat-row"><span class="stat-k">fill ratio</span><span class="stat-v">{ fmt.Sprintf("%.2f%%", d.WarmFillPct()) }</span></div>
						if d.WarmAvgObjSize() > 0 {
							<div class="stat-row"><span class="stat-k">avg object size</span><span class="stat-v">{ FmtBytes(d.WarmAvgObjSize()) }</span></div>
						}
					</div>
				</div>
				@cacheStorageChartScript(d.HotBytes, d.WarmBytes, d.HotEntries, d.WarmEntries)
			</div>
		}
	}
}

templ largeRingSVG(segs []api.RingSegment) {
	<div style="display:flex;flex-direction:column;align-items:center;gap:.6rem;padding:.5rem 0">
		<svg width="220" height="220" viewBox="0 0 220 220" role="img" aria-label="Consistent hash ring key ownership">
			<g transform="translate(110,110)">
				<circle r="80" fill="none" stroke="var(--b)" stroke-width="22"/>
				for _, arc := range BuildRingArcs(segs, 80) {
					<circle r="80" fill="none" stroke={ arc.Color } stroke-width="22" stroke-dasharray={ arc.DashArray } stroke-dashoffset={ arc.DashOffset } opacity=".8">
						<title>{ arc.NodeName } — { arc.PctLabel }</title>
					</circle>
				}
				for _, arc := range BuildRingArcs(segs, 80) {
					<text x={ fmt.Sprintf("%.1f", arc.LabelX) } y={ fmt.Sprintf("%.1f", arc.LabelY) } text-anchor="middle" fill={ arc.Color } font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{ arc.NodeName }</text>
					<text x={ fmt.Sprintf("%.1f", arc.LabelX2) } y={ fmt.Sprintf("%.1f", arc.LabelY2) } text-anchor="middle" fill="var(--m)" font-size="9" font-family="JetBrains Mono,monospace">{ arc.PctLabel } · { approxVnodes(arc.PctLabel) } vnodes</text>
				}
				<circle r="16" fill="var(--card)" stroke="var(--b)" stroke-width="1"/>
				<text x="0" y="4" text-anchor="middle" fill="var(--m)" font-size="8" font-family="JetBrains Mono,monospace">ring</text>
			</g>
		</svg>
	</div>
}

func approxVnodes(pctLabel string) string {
	var frac float64
	_, _ = fmt.Sscanf(pctLabel, "%f%%", &frac)
	n := int(math.Round(frac / 100 * 256))
	return strconv.Itoa(n)
}

func peerHealthSummary(health map[string]float64) string {
	if len(health) == 0 {
		return "—"
	}
	var total float64
	for _, v := range health {
		total += v
	}
	return fmt.Sprintf("%.0f%%", total/float64(len(health)))
}

// cacheStorageChartScript renders two doughnut charts showing the
// hot/warm tier distribution for content size (bytes) and object
// count (entries) on the cluster page.
script cacheStorageChartScript(hotBytes int64, warmBytes int64, hotEntries int64, warmEntries int64) {
	var d=document.documentElement.getAttribute('data-theme')!=='light';
	var colors=d?['#8b5cf6','#60a5fa']:['#7c3aed','#3b82f6'];
	try{if(window._cCacheBytes)window._cCacheBytes.destroy();}catch(e){}
	try{if(window._cCacheEntries)window._cCacheEntries.destroy();}catch(e){}
	var elB=document.getElementById('c-cache-bytes');
	var elE=document.getElementById('c-cache-entries');
	if(!elB||!elE)return;
	var ttOpts={backgroundColor:d?'#110e1c':'#fff',titleColor:d?'#c4b5fd':'#5b21b6',bodyColor:d?'#ede6ff':'#180840',borderColor:d?'#1e1830':'#e4d9ff',borderWidth:1,callbacks:{label:function(ctx){return ctx.label+': '+ctx.raw}}};
	requestAnimationFrame(function(){
		[elB,elE].forEach(function(c){
			c.removeAttribute('height');c.removeAttribute('width');
			c.style.cssText='position:absolute;top:0;left:0;width:100%;height:100%';
		});
		window._cCacheBytes=new Chart(elB,{type:'doughnut',data:{labels:['Hot','Warm'],datasets:[{data:[hotBytes,warmBytes],backgroundColor:colors,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'72%',plugins:{legend:{display:false},tooltip:ttOpts}}});
		window._cCacheEntries=new Chart(elE,{type:'doughnut',data:{labels:['Hot','Warm'],datasets:[{data:[hotEntries,warmEntries],backgroundColor:colors,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'72%',plugins:{legend:{display:false},tooltip:ttOpts}}});
	});
}
