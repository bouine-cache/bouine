package templates

import "fmt"

// Config renders the read-only config view. The left panel has a Structured /
// JSON / YAML toggle so operators can switch between the visual section view,
// a raw pretty-printed JSON, or a raw YAML dump of the running config.
templ Config(d ConfigData) {
	@Layout(d.LayoutProps) {
		<div class="pg-hd">
			<div>
				<h2>Config</h2>
				<div class="sub">running configuration — read-only; apply changes by rolling the pod</div>
			</div>
			<div class="tg" role="group" aria-label="Config view mode">
				<a
					id="cfg-btn-structured"
					class="tb active"
					aria-pressed="true"
					style="cursor:pointer"
					onclick="cfgToggle('structured')"
				>Structured</a>
				<a
					id="cfg-btn-json"
					class="tb"
					aria-pressed="false"
					style="cursor:pointer"
					onclick="cfgToggle('json')"
				>JSON</a>
				<a
					id="cfg-btn-yaml"
					class="tb"
					aria-pressed="false"
					style="cursor:pointer"
					onclick="cfgToggle('yaml')"
				>YAML</a>
			</div>
		</div>
		<div class="r2">
			<!-- left: running config viewer (three overlapping views) -->
			<div class="bc" style="overflow:auto;position:relative">
				<div class="bc-t" style="display:flex;justify-content:space-between;align-items:center">
					Current config (read-only)
					if d.ConfigPath != "" {
						<span style="font-size:.6rem;color:var(--m);font-family:'JetBrains Mono',monospace">
							{ d.ConfigPath }
						</span>
					}
				</div>
				<!-- Structured view -->
				<div id="cfg-view-structured">
					<!-- Capacity bars -->
					if d.HotMaxBytes > 0 || d.WarmMaxBytes > 0 {
						<div class="cfg-section">
							<div class="cfg-section-hd">
								<span class="cfg-section-icon">▮</span>
								capacity
								<span class="cfg-badge cfg-badge-y">live</span>
							</div>
							<div class="cfg-grid" style="padding:.5rem .75rem">
								<div class="tier-bar-wrap" style="margin-bottom:.6rem">
									<div class="tier-bar-label">
										<span>hot tier</span>
										<span>{ FmtBytes(d.HotBytes) } / { FmtBytes(d.HotMaxBytes) } · { fmt.Sprintf("%d entries", d.HotEntries) }</span>
									</div>
									<div class="tier-bar" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", d.HotFillPct()) } aria-valuemin="0" aria-valuemax="100">
										<div class="tier-bar-fill" style={ fmt.Sprintf("width:%.1f%%", d.HotFillPct()) }></div>
									</div>
								</div>
								<div class="tier-bar-wrap">
									<div class="tier-bar-label">
										<span>warm tier</span>
										<span>{ FmtBytes(d.WarmBytes) } / { FmtBytes(d.WarmMaxBytes) } · { fmt.Sprintf("%d entries", d.WarmEntries) }</span>
									</div>
									<div class="tier-bar" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", d.WarmFillPct()) } aria-valuemin="0" aria-valuemax="100">
										<div class="tier-bar-fill" style={ fmt.Sprintf("width:%.1f%%", d.WarmFillPct()) }></div>
									</div>
								</div>
							</div>
						</div>
					}
					if len(d.Sections) == 0 {
						<div style="font-size:.72rem;color:var(--m);padding:.5rem 0">Config not available.</div>
					}
					for _, sec := range d.Sections {
						<div class="cfg-section">
							<div class="cfg-section-hd">
								<span class="cfg-section-icon">{ sec.Icon }</span>
								{ sec.Title }
								if sec.Badge != "" {
									<span class={ "cfg-badge", cfgBadgeClass(sec.BadgeKind) }>{ sec.Badge }</span>
								}
							</div>
							if len(sec.Rows) > 0 {
								<div class="cfg-grid">
									for _, row := range sec.Rows {
										<div class="cfg-row">
											<span class="cfg-key">{ row.Key }</span>
											<span class="cfg-sep">:</span>
											<span class={ cfgValClass(row.Kind) }>{ row.Value }</span>
											if row.Hint != "" {
												<span class="cfg-hint">{ row.Hint }</span>
											}
										</div>
									}
								</div>
							}
							if len(sec.Routes) > 0 {
								for _, rc := range sec.Routes {
									<div class="cfg-route">
										<div class="cfg-route-hd">
											<span class="cfg-route-path">{ rc.PathPrefix }</span>
											<span class="cfg-route-pool">→ { rc.Pool }</span>
										</div>
										if len(rc.Rows) > 0 {
											<div class="cfg-grid cfg-grid-dense">
												for _, row := range rc.Rows {
													<div class="cfg-row">
														<span class="cfg-key">{ row.Key }</span>
														<span class="cfg-sep">:</span>
														<span class={ cfgValClass(row.Kind) }>{ row.Value }</span>
													</div>
												}
											</div>
										}
									</div>
								}
							}
						</div>
					}
				</div>
				<!-- JSON view (hidden by default) -->
				<div id="cfg-view-json" style="display:none">
					if d.RawJSON != "" {
						<pre style="font-family:'JetBrains Mono',monospace;font-size:.72rem;line-height:1.7;color:var(--t);white-space:pre-wrap;word-break:break-all;margin:0;padding:.25rem 0">{ d.RawJSON }</pre>
					} else {
						<div style="font-size:.72rem;color:var(--m);padding:.5rem 0">Config not available.</div>
					}
				</div>
				<!-- YAML view (hidden by default) -->
				<div id="cfg-view-yaml" style="display:none">
					if d.RawYAML != "" {
						<pre style="font-family:'JetBrains Mono',monospace;font-size:.72rem;line-height:1.7;color:var(--t);white-space:pre-wrap;word-break:break-all;margin:0;padding:.25rem 0">{ d.RawYAML }</pre>
					} else {
						<div style="font-size:.72rem;color:var(--m);padding:.5rem 0">Config not available.</div>
					}
				</div>
			</div>
		</div>
		@cfgToggleScript()
	}
}

script cfgToggleScript() {
	window.cfgToggle = function(mode) {
		var s = document.getElementById('cfg-view-structured');
		var j = document.getElementById('cfg-view-json');
		var y = document.getElementById('cfg-view-yaml');
		var bs = document.getElementById('cfg-btn-structured');
		var bj = document.getElementById('cfg-btn-json');
		var by = document.getElementById('cfg-btn-yaml');
		if (!s || !j || !y) return;
		s.style.display = 'none';
		j.style.display = 'none';
		y.style.display = 'none';
		bs.classList.remove('active'); bs.setAttribute('aria-pressed','false');
		bj.classList.remove('active'); bj.setAttribute('aria-pressed','false');
		by.classList.remove('active'); by.setAttribute('aria-pressed','false');
		if (mode === 'json') {
			j.style.display = '';
			bj.classList.add('active'); bj.setAttribute('aria-pressed','true');
		} else if (mode === 'yaml') {
			y.style.display = '';
			by.classList.add('active'); by.setAttribute('aria-pressed','true');
		} else {
			s.style.display = '';
			bs.classList.add('active'); bs.setAttribute('aria-pressed','true');
		}
	};
}

func cfgBadgeClass(kind string) string {
	switch kind {
	case "g":
		return "cfg-badge cfg-badge-g"
	case "y":
		return "cfg-badge cfg-badge-y"
	default:
		return "cfg-badge"
	}
}

func cfgValClass(kind string) string {
	switch kind {
	case "num", "dur":
		return "cfg-num"
	case "bool-t":
		return "cfg-bool cfg-bool-t"
	case "bool-f":
		return "cfg-bool cfg-bool-f"
	default:
		return "cfg-str"
	}
}

// ensure fmt is used
var _ = fmt.Sprintf
