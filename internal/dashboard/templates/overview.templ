package templates

import (
	"fmt"
	"strconv"

	"github.com/bouine-cache/bouine/pkg/api"
)

// Overview renders the main dashboard page.
templ Overview(d OverviewData) {
	@Layout(d.LayoutProps) {
		<!-- metric cards -->
		<div
			class="r4"
			hx-get={ pageHref("overview", d.TimeRange) }
			hx-trigger="every 5s"
			hx-swap="outerHTML"
			hx-select=".r4"
		>
			<div class="mc">
				<div class="mk">Requests / s</div>
				<div class="mv">{ FmtReqS(d.ReqPerSec) }</div>
				<div class="md">
					if d.TrendReq.Up {
						<span class="good">{ d.TrendReq.Label }</span>
					} else if d.TrendReq.Down {
						<span class="bad">{ d.TrendReq.Label }</span>
					} else {
						{ d.TrendReq.Label }
					}
				</div>
			</div>
			<div class="mc">
				<div class="mk">Hit ratio</div>
				<div class="mv">{ FmtHitPct(d.HitPct) }</div>
				<div class="md">
					if d.TrendHit.Up {
						<span class="good">{ d.TrendHit.Label }</span>
					} else if d.TrendHit.Down {
						<span class="bad">{ d.TrendHit.Label }</span>
					} else {
						{ d.TrendHit.Label }
					}
				</div>
			</div>
			<div class="mc">
				<div class="mk">p99 latency</div>
				<div class="mv">{ FmtLatMs(d.P99MS) }</div>
				<div class="md">
					<span style="color:var(--m)">p50 { FmtLatMs(d.P50MS) } · p90 { FmtLatMs(d.P90MS) }</span>
					if d.TrendLat.Up {
						<span class="good">{ d.TrendLat.Label }</span>
					} else if d.TrendLat.Down {
						<span class="bad">{ d.TrendLat.Label }</span>
					} else {
						{ d.TrendLat.Label }
					}
				</div>
			</div>
			<div class="mc">
				<div class="mk">Error rate</div>
				<div class="mv">{ FmtHitPct(d.ErrPct) }</div>
				<div class="md">
					if d.TrendErr.Down {
						<span class="bad">{ d.TrendErr.Label }</span>
					} else if d.TrendErr.Up {
						<span class="good">{ d.TrendErr.Label }</span>
					} else {
						{ d.TrendErr.Label }
					}
				</div>
			</div>
		</div>
		<!-- charts row -->
		<div class="r21">
			<div class="cc">
				<div class="ct">throughput ({ d.TimeRange })</div>
				<div class="ch"><canvas id="c-req" aria-label="Throughput chart"></canvas></div>
			</div>
			<div class="cc">
				<div class="ct">cache split (last 60s)</div>
				<div class="ch"><canvas id="c-split" aria-label="Cache split chart"></canvas></div>
			</div>
		</div>
		<!-- inline route table -->
		<div class="tc" style="margin-bottom:.5rem;flex-shrink:0">
			<div class="th">
				<span class="tl">Route performance</span>
				<span style="font-size:.62rem;color:var(--m);font-family:'JetBrains Mono',monospace">↻ 10s · click header to sort</span>
			</div>
			<table id="ov-route-tbl">
				<thead><tr>
					<th scope="col" class="sortable" tabindex="0" onclick="sortTable('ov-route-tbl',0,this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortTable('ov-route-tbl',0,this)}">Prefix<span class="sort-icon"></span></th>
					<th scope="col" class="sortable" tabindex="0" onclick="sortTable('ov-route-tbl',1,this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortTable('ov-route-tbl',1,this)}">Pool<span class="sort-icon"></span></th>
					<th scope="col" class="sortable desc" tabindex="0" onclick="sortTable('ov-route-tbl',2,this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortTable('ov-route-tbl',2,this)}">Hit %<span class="sort-icon"></span></th>
					<th scope="col" class="sortable" tabindex="0" onclick="sortTable('ov-route-tbl',3,this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortTable('ov-route-tbl',3,this)}">Req/min<span class="sort-icon"></span></th>
					<th scope="col" class="sortable" tabindex="0" onclick="sortTable('ov-route-tbl',4,this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortTable('ov-route-tbl',4,this)}">TTL<span class="sort-icon"></span></th>
					<th scope="col">Trend</th>
				</tr></thead>
				<tbody>
					if len(d.RouteRows) == 0 {
						<tr><td colspan="6" style="color:var(--m);text-align:center;padding:1rem">No traffic yet</td></tr>
					}
					for _, r := range d.RouteRows {
						<tr>
							<td>{ r.Name }</td>
							<td style="color:var(--m)">{ r.Pool }</td>
							<td data-val={ fmt.Sprintf("%.1f", r.HitPct) }>
								if r.IsBypass {
									<span class="lz d">bypass</span>
								} else if r.HitPct >= 80 {
									<span class="lz g">{ FmtHitPct(r.HitPct) }</span>
								} else if r.HitPct >= 50 {
									<span class="lz y">{ FmtHitPct(r.HitPct) }</span>
								} else {
									<span class="lz r">{ FmtHitPct(r.HitPct) }</span>
								}
							</td>
							<td data-val={ strconv.FormatInt(r.Requests, 10) }>{ strconv.FormatInt(r.Requests, 10) }</td>
							<td data-val="0">{ r.TTL }</td>
							<td>@sparkline(r.Sparkline)</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<!-- bottom row: peers | hot+warm | ring -->
		<div class="r3">
			<div class="bc">
				<div class="bc-t">Cluster peers</div>
				if len(d.PeerResults) == 0 {
					<div style="font-size:.72rem;color:var(--m)">Single-node mode</div>
				}
				for _, peer := range d.PeerResults {
					<div class="pr">
						<div>
							<div class="pn">{ peer.NodeName }</div>
							<div class="pa">
								if peer.DataAddr != "" {
									{ peer.DataAddr } ·{ " " }
								}
								if peer.Stale {
									stale
								} else {
									{ TimeAgo(peer.JoinedAt) }
								}
							</div>
						</div>
						<span class={ "pd", templ.KV("pd-stale", peer.Stale) } aria-hidden="true"></span>
					</div>
				}
			</div>
			<div class="bc">
				<div class="bc-t">Hot &amp; Warm store</div>
				<div class="stat-row">
					<span class="stat-k">hot entries</span>
					<span class="stat-v">{ FmtInt(int(d.HotEntries)) }</span>
				</div>
				<div class="tier-bar-wrap">
					<div class="tier-bar-label">
						<span>hot used</span>
						<span>{ FmtBytes(d.HotBytes) } / { FmtBytes(d.HotMaxBytes) }</span>
					</div>
					<div class="tier-bar" role="progressbar" aria-valuenow={ fmt.Sprintf("%.0f", d.HotFillPct()) } aria-valuemin="0" aria-valuemax="100">
						<div class="tier-bar-fill" style={ fmt.Sprintf("width:%.1f%%", d.HotFillPct()) }></div>
					</div>
				</div>
				<div class="stat-row">
					<span class="stat-k">warm entries</span>
					<span class="stat-v">{ FmtInt(int(d.WarmEntries)) }</span>
				</div>
				<div class="tier-bar-wrap">
					<div class="tier-bar-label">
						<span>warm used</span>
						<span>{ FmtBytes(d.WarmBytes) } / { FmtBytes(d.WarmMaxBytes) }</span>
					</div>
					<div class="tier-bar">
						<div class="tier-bar-fill" style={ fmt.Sprintf("width:%.1f%%", d.WarmFillPct()) }></div>
					</div>
				</div>
				<div class="stat-row" style="margin-top:.3rem">
					<span class="stat-k">evictions / min</span>
					<span class="stat-v">{ FmtInt(int(d.Evictions)) }</span>
				</div>
			</div>
			<div class="bc">
				if d.ClusterMode == "strong" {
					<div class="bc-t">Consistent hash ring</div>
					if len(d.RingSegs) == 0 {
						<div style="font-size:.72rem;color:var(--m)">Single-node · no ring data</div>
					} else {
						@compactRingSVG(d.RingSegs)
					}
				} else {
					<div class="bc-t">Cluster mode</div>
					<div style="font-size:.72rem;color:var(--m);line-height:1.6">
						if d.ClusterMode == "eventual" {
							Eventual — local cache, gossip invalidation, no peer fetch
						} else {
							{ d.ClusterMode }
						}
					</div>
				}
			</div>
		</div>
		@overviewChartScript(d.ChartLabels, d.ChartReqs, d.ChartErrs,
			d.CacheSplit.Hits, d.CacheSplit.Misses, d.CacheSplit.Stales,
			d.CacheSplit.Bypasses, d.CacheSplit.Revalidated)
	}
}

// compactRingSVG renders a 120×120 circular ring donut for the overview tile.
templ compactRingSVG(segs []api.RingSegment) {
	<div style="display:flex;flex-direction:column;align-items:center;gap:.4rem">
		<svg width="120" height="120" viewBox="0 0 140 140" role="img" aria-label="Hash ring ownership">
			<g transform="translate(70,70)">
				<circle r="46" fill="none" stroke="var(--b)" stroke-width="14"/>
				for _, arc := range BuildRingArcs(segs, 46) {
					<circle r="46" fill="none" stroke={ arc.Color } stroke-width="14" stroke-dasharray={ arc.DashArray } stroke-dashoffset={ arc.DashOffset } opacity=".85">
						<title>{ arc.NodeName } — { arc.PctLabel }</title>
					</circle>
					<text x={ fmt.Sprintf("%.1f", arc.LabelX) } y={ fmt.Sprintf("%.1f", arc.LabelY) } text-anchor="middle" fill={ arc.Color } font-size="8" font-family="JetBrains Mono,monospace" font-weight="700">{ shortName(arc.NodeName) }</text>
				}
				<text x="0" y="4" text-anchor="middle" fill="var(--m)" font-size="8" font-family="JetBrains Mono,monospace">ring</text>
			</g>
		</svg>
		<div class="ring-legend">
			for i, seg := range segs {
				<span>
					<span class="ring-legend-dot" style={ ringDotStyle(i) }></span>
					<span style="color:var(--m);font-size:.65rem">{ seg.NodeName } · { fmt.Sprintf("%.0f%%", seg.Frac*100) }</span>
				</span>
			}
		</div>
	</div>
}

func shortName(name string) string {
	if len(name) > 6 {
		return name[:3] + "…"
	}
	return name
}

script overviewChartScript(
	labels []string,
	reqs []int64,
	errs []int64,
	splitHits int64,
	splitMisses int64,
	splitStales int64,
	splitBypasses int64,
	splitRevalidated int64,
) {
	var d=document.documentElement.getAttribute('data-theme')!=='light';
	var gc={color:d?'rgba(196,181,253,.05)':'rgba(91,33,182,.04)'};
	var tc={color:d?'#6050a0':'#9ca3af',font:{size:9}};
	try{if(window._cReq)window._cReq.destroy();}catch(e){}
	try{if(window._cSplit)window._cSplit.destroy();}catch(e){}
	var cReqEl=document.getElementById('c-req');
	var cSplitEl=document.getElementById('c-split');
	if(!cReqEl||!cSplitEl)return;
	requestAnimationFrame(function(){
	[cReqEl,cSplitEl].forEach(function(c){
		c.removeAttribute('height');c.removeAttribute('width');
		c.style.position='absolute';c.style.top='0';c.style.left='0';
		c.style.right='0';c.style.bottom='0';c.style.width='100%';c.style.height='100%';
	});
	window._cReq=new Chart(cReqEl,{type:'line',data:{labels:labels,datasets:[
		{label:'req/s',data:reqs,borderColor:d?'#c4b5fd':'#5b21b6',backgroundColor:d?'rgba(196,181,253,.07)':'rgba(91,33,182,.05)',fill:true,tension:.4,pointRadius:0,borderWidth:1.5},
		{label:'errors',data:errs,borderColor:d?'#fb7185':'#e11d48',backgroundColor:'transparent',tension:.4,pointRadius:0,borderWidth:1},
	]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:d?'#6050a0':'#8b7ab8',font:{size:9}}}},scales:{x:{grid:gc,ticks:{color:tc.color,font:tc.font,maxTicksLimit:8}},y:{grid:gc,ticks:{color:tc.color,font:tc.font}}}}});
	var splitColors=d?['#c4b5fd','#6050a0','#fbbf24','#fb7185','#34d399']:['#5b21b6','#a78bfa','#b45309','#e11d48','#059669'];
	window._cSplit=new Chart(cSplitEl,{
		type:'doughnut',
		data:{labels:['HIT','MISS','STALE','BYP','REVAL'],datasets:[{data:[splitHits,splitMisses,splitStales,splitBypasses,splitRevalidated],backgroundColor:splitColors,borderWidth:0}]},
		options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:d?'#6050a0':'#8b7ab8',font:{size:9},padding:5}}},cutout:'70%'}
	});
	});
}
