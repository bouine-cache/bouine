package templates

import (
	"fmt"
	"strconv"
)

// Routes renders the per-route performance table with config columns and charts.
templ Routes(d RoutesData) {
	@Layout(d.LayoutProps) {
		<div class="pg-hd">
			<div>
				<h2>Routes</h2>
				<div class="sub">
					{ strconv.Itoa(d.RouteCount) } configured routes · polled every 10s
				</div>
			</div>
			<input class="search-bar" placeholder="Filter by prefix or pool…" oninput="filterTable(this,'route-tbl')" aria-label="Filter routes"/>
		</div>
		<div id="routes-data"
			hx-get={ pageHref("routes", d.TimeRange) }
			hx-trigger="every 10s"
			hx-swap="outerHTML"
			hx-select="#routes-data"
		>
		<div class="tc" style="margin-bottom:.5rem">
			<table id="route-tbl">
				<thead>
					<tr>
						<th class="sortable" onclick="sortTable('route-tbl',0,this)">Route<span class="sort-icon"></span></th>
						<th class="sortable" onclick="sortTable('route-tbl',1,this)">Pool<span class="sort-icon"></span></th>
						<th class="sortable desc" onclick="sortTable('route-tbl',2,this)">Hit %<span class="sort-icon"></span></th>
						<th class="sortable" onclick="sortTable('route-tbl',3,this)">Req/min<span class="sort-icon"></span></th>
						<th class="sortable" onclick="sortTable('route-tbl',4,this)">TTL<span class="sort-icon"></span></th>
						<th title="stale-while-revalidate: serve the stale cached response while revalidating with origin in the background for up to this duration after TTL expiry.">SWR</th>
						<th title="stale-if-error: serve the stale cached response when origin returns a 5xx error or is unreachable, for up to this duration after TTL expiry.">SIE</th>
						<th title="negative_ttl: cache error responses (404, 405, 410, 501) for this duration to reduce origin load from repeated requests for non-existent resources.">neg_ttl</th>
						<th title="stayin_alive: when enabled, serve stale content indefinitely during an origin outage regardless of stale-if-error window. Useful for routes where stale is always better than an error.">stayin_alive</th>
						<th title="jitter_percent: add a random ±N% variance to every TTL. Prevents cache stampedes where many entries expire simultaneously and flood the origin.">jitter</th>
						<th>Trend</th>
					</tr>
				</thead>
				<tbody>
					if len(d.RouteRows) == 0 {
						<tr><td colspan="11" style="color:var(--m);text-align:center;padding:1rem">No data yet</td></tr>
					}
					for _, r := range d.RouteRows {
						<tr>
							<td>{ r.Name }</td>
							<td style="color:var(--m)">{ r.Pool }</td>
							<td data-val={ fmt.Sprintf("%.1f", r.HitPct) }>
								if r.IsBypass {
									<span class="lz d">bypass</span>
								} else if r.HitPct >= 80 {
									<span class="lz g">{ FmtHitPct(r.HitPct) }</span>
								} else if r.HitPct >= 50 {
									<span class="lz y">{ FmtHitPct(r.HitPct) }</span>
								} else {
									<span class="lz r">{ FmtHitPct(r.HitPct) }</span>
								}
							</td>
							<td data-val={ strconv.FormatInt(r.Requests, 10) }>{ strconv.FormatInt(r.Requests, 10) }</td>
							<td>{ r.TTL }</td>
							<td>{ r.SWR }</td>
							<td>{ r.SIE }</td>
							<td>{ r.NegTTL }</td>
							<td>
								if r.StayinAlive {
									<span class="lz g">true</span>
								} else {
									<span class="lz d">false</span>
								}
							</td>
							<td>{ r.Jitter }</td>
							<td>@sparkline(r.Sparkline)</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="r2" style="height:200px;margin-bottom:.5rem;flex-shrink:0">
			<div class="cc">
				<div class="ct">hit ratio by route ({ d.TimeRange })</div>
				<div class="ch"><canvas id="c-routes-hit" aria-label="Hit ratio by route"></canvas></div>
			</div>
			<div class="cc">
				<div class="ct">req/min by route</div>
				<div class="ch"><canvas id="c-routes-req" aria-label="Requests per minute by route"></canvas></div>
			</div>
		</div>
		if len(d.URLStats) > 0 {
			<div class="tc">
				<div class="th">
					<span class="tl">URL drill-down</span>
					<span style="font-size:.62rem;color:var(--m);font-family:'JetBrains Mono',monospace">
						{ strconv.Itoa(len(d.URLStats)) } paths · top 3 segments
					</span>
				</div>
				<table id="url-tbl">
					<thead>
						<tr>
							<th class="sortable" onclick="sortTable('url-tbl',0,this)">Path<span class="sort-icon"></span></th>
							<th class="sortable" onclick="sortTable('url-tbl',1,this)">Route<span class="sort-icon"></span></th>
							<th class="sortable" onclick="sortTable('url-tbl',2,this)">Requests<span class="sort-icon"></span></th>
							<th class="sortable" onclick="sortTable('url-tbl',3,this)">Hits<span class="sort-icon"></span></th>
							<th class="sortable desc" onclick="sortTable('url-tbl',4,this)">Hit %<span class="sort-icon"></span></th>
						</tr>
					</thead>
					<tbody>
						for _, us := range d.URLStats {
							<tr>
								<td>{ us.URL }</td>
								<td style="color:var(--m);font-size:.7rem">{ us.Route }</td>
								<td data-val={ strconv.FormatInt(us.Requests, 10) }>{ strconv.FormatInt(us.Requests, 10) }</td>
								<td data-val={ strconv.FormatInt(us.Hits, 10) }>{ strconv.FormatInt(us.Hits, 10) }</td>
								<td data-val={ fmt.Sprintf("%.1f", us.HitPct) }>
									if us.HitPct >= 80 {
										<span class="lz g">{ FmtHitPct(us.HitPct) }</span>
									} else if us.HitPct >= 50 {
										<span class="lz y">{ FmtHitPct(us.HitPct) }</span>
									} else {
										<span class="lz r">{ FmtHitPct(us.HitPct) }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@routeChartsScript(routeNames(d.RouteRows), routeHits(d.RouteRows), routeReqs(d.RouteRows))
		</div><!-- /routes-data -->
	}
}

script routeChartsScript(routes []string, hits []float64, reqs []int64) {
	var d=document.documentElement.getAttribute('data-theme')!=='light';
	var colors=d?['#c4b5fd','#8b5cf6','#6d28d9','#a78bfa','#6050a0']:['#5b21b6','#7c3aed','#a78bfa','#4c1d95','#8b7ab8'];
	try{if(window._cRHit)window._cRHit.destroy();}catch(e){}
	try{if(window._cRReq)window._cRReq.destroy();}catch(e){}
	var cHitEl=document.getElementById('c-routes-hit');
	var cReqEl=document.getElementById('c-routes-req');
	if(!cHitEl||!cReqEl)return;
	// responsive:false + explicit pixel sizing from the settled layout.
	// responsive:true causes a ResizeObserver feedback loop where
	// sub-pixel rounding from CSS rem padding/gap drifts the measured
	// clientWidth wider on each htmx swap cycle. With responsive:false
	// Chart.js never attaches a ResizeObserver — the chart is fixed at
	// the dimensions we give it, read once after layout settles in rAF.
	requestAnimationFrame(function(){
	[cHitEl,cReqEl].forEach(function(c){
		var p=c.parentElement;
		if(!p)return;
		var w=p.clientWidth,h=p.clientHeight;
		c.width=w;c.height=h;
		c.style.cssText='width:'+w+'px;height:'+h+'px';
	});
	var baseOpts={responsive:false,maintainAspectRatio:false,plugins:{legend:{display:false}}};
	var axTick={color:d?'#6050a0':'#9ca3af',font:{size:9}};
	var axGrid={color:d?'rgba(196,181,253,.05)':'rgba(91,33,182,.04)'};
	window._cRHit=new Chart(cHitEl,{type:'bar',data:{labels:routes,datasets:[{data:hits,backgroundColor:colors,borderRadius:4}]},options:Object.assign({},baseOpts,{scales:{x:{grid:{display:false},ticks:axTick},y:{max:100,grid:axGrid,ticks:axTick}}})});
	window._cRReq=new Chart(cReqEl,{type:'bar',data:{labels:routes,datasets:[{data:reqs,backgroundColor:colors,borderRadius:4}]},options:Object.assign({},baseOpts,{scales:{x:{grid:{display:false},ticks:axTick},y:{grid:axGrid,ticks:axTick}}})});
	});// end rAF
}

func routeNames(rows []RouteRow) []string {
	names := make([]string, 0, len(rows))
	for _, r := range rows {
		names = append(names, r.Name)
	}
	return names
}

func routeHits(rows []RouteRow) []float64 {
	vals := make([]float64, 0, len(rows))
	for _, r := range rows {
		vals = append(vals, r.HitPct)
	}
	return vals
}

func routeReqs(rows []RouteRow) []int64 {
	vals := make([]int64, 0, len(rows))
	for _, r := range rows {
		vals = append(vals, r.Requests)
	}
	return vals
}

// sparkline renders a small bar chart from a slice of per-minute counts.
templ sparkline(vals []int64) {
	<span class="sp-bar">
		for _, v := range vals {
			<span style={ sparkBarStyle(v, maxVal(vals)) }></span>
		}
	</span>
}

func sparkBarStyle(v, maxV int64) string {
	if maxV == 0 {
		return "height:2px"
	}
	h := max(int(float64(v)/float64(maxV)*16), 2)
	return fmt.Sprintf("height:%dpx", h)
}

func maxVal(vals []int64) int64 {
	var m int64
	for _, v := range vals {
		if v > m {
			m = v
		}
	}
	return m
}
