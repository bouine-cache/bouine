package templates

import (
	"fmt"
	"strconv"
)

// Routes renders the per-route performance table with sparklines,
// followed by a per-URL drill-down showing the top-N cached paths.
templ Routes(d RoutesData) {
	@Layout(d.LayoutProps) {
		<div class="pg-hd">
			<div>
				<h2>Route performance</h2>
				<div class="sub">cluster-wide aggregated · polled every 10s</div>
			</div>
			<input class="search-bar" placeholder="Filter…" oninput="filterTable(this,'route-tbl')"/>
		</div>
		<div
			class="tc"
			hx-get="/dashboard/routes"
			hx-trigger="every 10s"
			hx-swap="outerHTML"
			hx-select=".tc"
		>
			<div class="th">
				<span class="tl">Routes</span>
				<span style="font-size:.62rem;color:var(--m);font-family:'JetBrains Mono',monospace">
					{ strconv.Itoa(len(d.RouteStats)) } routes
				</span>
			</div>
			<table id="route-tbl">
				<thead>
					<tr>
						<th onclick="sortTable('route-tbl',0,this)" scope="col">Route ↕</th>
						<th onclick="sortTable('route-tbl',1,this)" scope="col">Trend</th>
						<th onclick="sortTable('route-tbl',2,this)" scope="col">Requests ↕</th>
						<th onclick="sortTable('route-tbl',3,this)" scope="col">Hits ↕</th>
						<th onclick="sortTable('route-tbl',4,this)" scope="col">Hit % ↕</th>
					</tr>
				</thead>
				<tbody>
					if len(d.RouteStats) == 0 {
						<tr>
							<td colspan="5" style="color:var(--m);text-align:center;padding:1rem">
								No data yet — traffic will populate this table.
							</td>
						</tr>
					}
					for _, rs := range d.RouteStats {
						<tr>
							<td>{ rs.Route }</td>
							<td>@sparkline(rs.Sparkline)</td>
							<td data-val={ strconv.FormatInt(rs.Requests, 10) }>
								{ strconv.FormatInt(rs.Requests, 10) }
							</td>
							<td data-val={ strconv.FormatInt(rs.Hits, 10) }>
								{ strconv.FormatInt(rs.Hits, 10) }
							</td>
							<td data-val={ fmt.Sprintf("%.1f", rs.HitPct) }>
								if rs.HitPct >= 80 {
									<span class="lz g">{ FmtHitPct(rs.HitPct) }</span>
								} else if rs.HitPct >= 50 {
									<span class="lz y">{ FmtHitPct(rs.HitPct) }</span>
								} else {
									<span class="lz r">{ FmtHitPct(rs.HitPct) }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.URLStats) > 0 {
			<div class="tc" style="margin-top:.5rem">
				<div class="th">
					<span class="tl">URL drill-down</span>
					<span style="font-size:.62rem;color:var(--m);font-family:'JetBrains Mono',monospace">
						{ strconv.Itoa(len(d.URLStats)) } paths · top 3 path segments
					</span>
				</div>
				<table id="url-tbl">
					<thead>
						<tr>
							<th onclick="sortTable('url-tbl',0,this)" scope="col">Path ↕</th>
							<th onclick="sortTable('url-tbl',1,this)" scope="col">Route ↕</th>
							<th onclick="sortTable('url-tbl',2,this)" scope="col">Requests ↕</th>
							<th onclick="sortTable('url-tbl',3,this)" scope="col">Hits ↕</th>
							<th onclick="sortTable('url-tbl',4,this)" scope="col">Hit % ↕</th>
						</tr>
					</thead>
					<tbody>
						for _, us := range d.URLStats {
							<tr>
								<td>{ us.URL }</td>
								<td style="color:var(--m);font-size:.7rem">{ us.Route }</td>
								<td data-val={ strconv.FormatInt(us.Requests, 10) }>{ strconv.FormatInt(us.Requests, 10) }</td>
								<td data-val={ strconv.FormatInt(us.Hits, 10) }>{ strconv.FormatInt(us.Hits, 10) }</td>
								<td data-val={ fmt.Sprintf("%.1f", us.HitPct) }>
									if us.HitPct >= 80 {
										<span class="lz g">{ FmtHitPct(us.HitPct) }</span>
									} else if us.HitPct >= 50 {
										<span class="lz y">{ FmtHitPct(us.HitPct) }</span>
									} else {
										<span class="lz r">{ FmtHitPct(us.HitPct) }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// sparkline renders a small bar chart from a slice of per-minute counts.
templ sparkline(vals []int64) {
	<span class="sp-bar">
		for _, v := range vals {
			<span style={ sparkBarStyle(v, maxVal(vals)) }></span>
		}
	</span>
}

func sparkBarStyle(v, maxV int64) string {
	if maxV == 0 {
		return "height:2px"
	}
	h := max(int(float64(v)/float64(maxV)*16), 2)
	return fmt.Sprintf("height:%dpx", h)
}

func maxVal(vals []int64) int64 {
	var m int64
	for _, v := range vals {
		if v > m {
			m = v
		}
	}
	return m
}
